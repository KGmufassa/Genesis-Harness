{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-5-output.schema.json",
  "title": "Stage 5 Umbrella Output",
  "oneOf": [
    {
      "title": "Normalized Stage 5 v2 package",
      "type": "object",
      "required": ["format_version", "context", "artifacts", "manifest"],
      "properties": {
        "format_version": { "const": "2.0" },
        "context": { "$ref": "stage-5-context.schema.json" },
        "artifacts": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "stage-5-artifact.schema.json" },
          "default": []
        },
        "manifest": { "$ref": "stage-5-manifest.schema.json" }
      },
      "additionalProperties": true
    },
    {
      "title": "Archived self-contained Stage 5 output",
      "allOf": [{ "$ref": "stage-output-common.schema.json" }],
      "properties": {
        "visual_reference_inputs": { "type": "object", "default": {} },
        "visual_reference_refs": { "type": "array", "default": [] },
        "ticket_visual_reference_assignments": { "type": "array", "default": [] },
        "visual_reference_handoff_packages": { "type": "array", "default": [] }
      },
      "additionalProperties": true
    }
  ],
  "additionalProperties": true
}
